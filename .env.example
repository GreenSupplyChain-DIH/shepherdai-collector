JETSON_BASE_URL=http://192.168.10.102:8000
JETSON_API_KEY=
JETSON_API_KEY_HEADER=x-api-key
JETSON_ENDPOINT=/api/v1/cows
POLL_INTERVAL=2s
REQUEST_TIMEOUT=10s
DATABASE_URL=postgres://cow_collector:cow_collector@postgres:5432/ocei3?sslmode=disable
PG_SCHEMA=jetson_telemetry
PG_TELEMETRY_TABLE=cow_telemetry_history
PG_ALERTS_TABLE=cow_alert_events
TARGET_COW_IDS=3,10,12
ALLOW_ALL_COW_IDS=false
HEALTH_ADDR=:8081
BUFFER_PATH=./var/spool/pending.jsonl
LOG_LEVEL=INFO
BATCH_SIZE=100
BACKOFF_BASE=2s
BACKOFF_MAX=30s
